<Window x:Class="HEMA.WpfApp.DuplicateFightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конфликт при импорте"
        Width="460"
        Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        KeyDown="Window_KeyDown">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock x:Name="MessageTextBlock"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   FontSize="16"
                   VerticalAlignment="Top" />

		<CheckBox x:Name="ApplyToAllCheckBox"
                  Grid.Row="1"
                  Margin="0,16,0,0"
                  Content="Для всех" />

		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
			<Button x:Name="AddButton"
                    Content="Добавить"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="AddButton_Click" />

			<Button x:Name="ReplaceButton"
                    Content="Заменить"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="ReplaceButton_Click" />

			<Button x:Name="IgnoreButton"
                    Content="Игнорировать"
                    Width="110"
                    Click="IgnoreButton_Click" />
		</StackPanel>
	</Grid>
</Window>