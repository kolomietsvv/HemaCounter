<UserControl x:Class="HEMA.WpfApp.Controls.HostsListPopupContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

	<Grid HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Margin="0,20,0,0">
		<Border Background="White"
                BorderBrush="#CCC"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Width="400"
                Opacity="0"
                Focusable="True"
                Loaded="RootBorder_Loaded"
                KeyDown="RootBorder_KeyDown">
			<Border.Triggers>
				<EventTrigger RoutedEvent="Loaded">
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="-30"
                                             To="0"
                                             Duration="0:0:0.25"
                                             DecelerationRatio="0.8"/>
							<DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.25"/>
						</Storyboard>
					</BeginStoryboard>
				</EventTrigger>
			</Border.Triggers>

			<Border.RenderTransform>
				<TranslateTransform Y="0"/>
			</Border.RenderTransform>

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0"
                           Text="Выбор хоста"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

				<TextBlock Grid.Row="1"
                           Text="Выберите имя машины"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

				<Border Grid.Row="2"
                        BorderBrush="#EEE"
                        BorderThickness="1"
                        CornerRadius="6">
					<ListView x:Name="HostsListView"
                              ItemsSource="{Binding DiscoveredHosts}"
                              SelectedItem="{Binding SelectedHost, Mode=TwoWay}"
                              FontSize="18"
                              MinHeight="220"
                              MouseDoubleClick="HostsListView_MouseDoubleClick">
						<ListView.View>
							<GridView>
								<GridViewColumn Header="Имя" Width="220" DisplayMemberBinding="{Binding Name}" />
								<GridViewColumn Header="IP" Width="150" DisplayMemberBinding="{Binding IpAddress}" />
							</GridView>
						</ListView.View>
					</ListView>
				</Border>

				<StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0">
					<Button Content="Отмена"
                            Width="110"
                            Background="LightGray"
                            HorizontalContentAlignment="Right"
                            Tag="Esc"
                            Click="CancelButton_Click"/>

					<Button Content="Выбрать"
                            Width="160"
                            Margin="10,0,0,0"
                            Background="LightGreen"
                            HorizontalContentAlignment="Right"
                            Tag="↵"
                            Click="ConnectButton_Click"/>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</UserControl>